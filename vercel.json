{
  "name": "khoa-hoc-giao-viec",
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/sepay-webhook", "destination": "/api/sepay-webhook.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
